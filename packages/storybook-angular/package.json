{
  "name": "@gemeente-tilburg/storybook-angular",
  "description": "Storybook for the Tilburg Angular components and the shared HTML/CSS reference (runs separately from the React Storybook)",
  "author": "Community for NL Design System",
  "license": "EUPL-1.2",
  "keywords": [
    "nl-design-system"
  ],
  "private": true,
  "repository": {
    "type": "git+ssh",
    "url": "git@github.com:nl-design-system/tilburg.git",
    "directory": "packages/storybook-angular"
  },
  "scripts": {
    "build": "ng run storybook-angular:build-storybook",
    "clean": "rimraf dist/",
    "lint": "tsc --noEmit --project tsconfig.lint.json && tsc --noEmit --project tsconfig.manager.json",
    "storybook": "ng run storybook-angular:storybook"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "22.2.4",
    "@angular/animations": "22.2.3",
    "@angular/cli": "22.2.4",
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/platform-browser-dynamic": "22.2.3",
    "@gemeente-tilburg/components-angular": "workspace:*",
    "@gemeente-tilburg/components-css": "workspace:*",
    "@gemeente-tilburg/design-tokens": "workspace:*",
    "@gemeente-tilburg/font": "workspace:*",
    "@storybook/addon-a11y": "10.6.3",
    "@storybook/addon-docs": "10.6.3",
    "@storybook/angular": "10.6.3",
    "@types/react": "18.3.12",
    "@utrecht/component-library-angular": "1.1.0",
    "@utrecht/component-library-css": "5.2.0",
    "rimraf": "6.0.1",
    "rxjs": "7.8.1",
    "storybook": "10.6.3",
    "typescript": "6.0.3",
    "zone.js": "0.15.0"
  }
}

{
  "name": "@gemeente-tilburg/web-components-stencil",
  "version": "0.0.0",
  "description": "Framework-agnostic Stencil web components (tilburg-webc-*) for the Municipality of Tilburg, based on the NL Design System architecture",
  "author": "Community for NL Design System",
  "license": "EUPL-1.2",
  "keywords": [
    "nl-design-system"
  ],
  "private": true,
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.js",
  "types": "./dist/types/components.d.ts",
  "collection": "./dist/collection/collection-manifest.json",
  "collection:main": "./dist/collection/collection-manifest.json",
  "unpkg": "./dist/tilburg/tilburg.esm.js",
  "files": [
    "dist/",
    "loader/"
  ],
  "repository": {
    "type": "git+ssh",
    "url": "git@github.com:nl-design-system/tilburg.git",
    "directory": "packages/web-components-stencil"
  },
  "scripts": {
    "build": "npm-run-all clean build:stencil",
    "build:stencil": "stencil build",
    "clean": "rimraf dist/ loader/ www/ ../web-components-react/src/components.ts ../web-components-react/src/react-component-lib/",
    "start": "stencil build --dev --watch --serve",
    "watch": "npm-run-all --parallel watch:**",
    "watch:stencil": "stencil build --watch",
    "generate": "stencil generate",
    "test": "stencil test --spec --runInBand",
    "watch:test": "stencil test --spec --runInBand --watchAll",
    "lint": "tsc --noEmit --project tsconfig.json"
  },
  "devDependencies": {
    "@gemeente-tilburg/components-css": "workspace:*",
    "@stencil/react-output-target": "0.5.3",
    "@stencil/sass": "3.3.3",
    "@types/jest": "29.5.12",
    "chokidar-cli": "3.0.0",
    "jest": "29.7.0",
    "jest-cli": "29.7.0",
    "npm-run-all": "4.1.5",
    "rimraf": "6.0.1",
    "tslib": "2.6.2",
    "typescript": "5.4.5"
  },
  "dependencies": {
    "@stencil/core": "4.45.0"
  }
}

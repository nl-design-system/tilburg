{
  "//": [
    "┌────────────────────────────────────────────────────────┐",
    "│ TILBURG NLDS · start here                              │",
    "│                                                        │",
    "│ pnpm start       the developer menu: every command     │",
    "│ pnpm setup       fresh clone to a running Storybook    │",
    "│ pnpm check       what is missing on this machine       │",
    "│                  (--fix offers the fixes)              │",
    "│ pnpm commands    every command, one line each          │",
    "│                                                        │",
    "│ Needs Node 24 (nvm use) and pnpm through corepack;     │",
    "│ node scripts/setup.mjs works before pnpm does.         │",
    "└────────────────────────────────────────────────────────┘"
  ],
  "name": "@gemeente-tilburg/design-system",
  "author": "Community for NL Design System",
  "description": "Design system based on the NL Design System architecture",
  "license": "EUPL-1.2",
  "keywords": [
    "nl-design-system"
  ],
  "private": true,
  "repository": {
    "type": "git+ssh",
    "url": "git@github.com:nl-design-system/tilburg.git",
    "directory": "."
  },
  "packageManager": "pnpm@11.15.1+sha512.81350b07e53c9538a02f1f2303b4290fa2d7be04e56e2a970c4cc4b417dc761de196edabd49d55c7dc9580db81007c44143e4e3d7e462b3000d23c255122d065",
  "engines": {
    "//": "Update @types/node to match the highest node version here",
    "node": ">=24 <=25",
    "pnpm": "^11.4.0",
    "npm": "please use pnpm: node scripts/setup.mjs"
  },
  "workspaces": [
    "./packages/*",
    "./proprietary/*"
  ],
  "devDependencies": {
    "@changesets/cli": "3.0.1",
    "@types/node": "24.10.4",
    "@typescript-eslint/eslint-plugin": "7.17.0",
    "@typescript-eslint/parser": "7.17.0",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-json": "3.1.0",
    "eslint-plugin-mdx": "3.1.5",
    "eslint-plugin-react": "7.37.2",
    "http-server": "14.1.1",
    "husky": "9.1.6",
    "lint-staged": "15.2.10",
    "markdownlint-cli": "0.49.1",
    "npm-check-updates": "22.2.9",
    "npm-package-json-lint": "8.0.0",
    "npm-run-all": "4.1.5",
    "postcss": "8.5.28",
    "prettier": "3.3.3",
    "stylelint": "16.10.0",
    "stylelint-config-standard-scss": "13.1.0",
    "stylelint-order": "6.0.4",
    "typescript": "5.5.4"
  },
  "scripts": {
    "build": "pnpm --recursive run build",
    "build:site": "pnpm run build && rm -rf packages/storybook/dist/angular && cp -R packages/storybook-angular/dist packages/storybook/dist/angular",
    "check": "node scripts/check.mjs",
    "clean": "pnpm --recursive run clean",
    "clean:pick": "node scripts/clean.mjs",
    "commands": "node scripts/help.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:angular": "node scripts/dev.mjs angular",
    "dev:react": "node scripts/dev.mjs react",
    "help": "node scripts/help.mjs",
    "lint": "npm-run-all --continue-on-error lint:** lint-workspaces",
    "lint-fix": "npm-run-all --continue-on-error lint-fix:** prettier",
    "lint-fix:css": "stylelint --fix '**/*.{css,scss}'",
    "lint-fix:js": "eslint --ext .js,.cjs,.mjs,.json,.jsx,.mdx,.ts,.tsx --fix --report-unused-disable-directives .",
    "lint-fix:md": "markdownlint --fix '**/*.md'",
    "lint-workspaces": "pnpm --recursive run lint",
    "lint:css": "stylelint --allow-empty-input '**/*.{css,scss}'",
    "lint:js": "eslint --ext .js,.cjs,.mjs,.json,.jsx,.mdx,.ts,.tsx --report-unused-disable-directives .",
    "lint:md": "markdownlint '**/*.md'",
    "lint:package-json": "npmPkgJsonLint .",
    "lint:package-lock": "pnpm ls --recursive",
    "logs": "node scripts/logs.mjs",
    "menu": "node scripts/hub.mjs",
    "pack:local": "node scripts/pack-local.mjs",
    "parity": "node scripts/parity.mjs",
    "postinstall": "node scripts/welcome.mjs",
    "preinstall": "node scripts/preflight.mjs",
    "prepare": "husky",
    "prettier": "prettier --write .",
    "publish": "changeset publish",
    "serve": "http-server packages/storybook/dist/",
    "setup": "node scripts/setup.mjs",
    "setup:reset": "node scripts/setup.mjs --reset",
    "ship": "node scripts/ship.mjs",
    "start": "node scripts/hub.mjs",
    "storybook": "node scripts/dev.mjs",
    "storybook:angular": "node scripts/dev.mjs angular",
    "storybook:react": "node scripts/dev.mjs react",
    "sync": "node scripts/sync-consumers.mjs",
    "test": "node scripts/test.mjs",
    "test-update": "npm-run-all --sequential clean lint build test",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "update-major": "npm-check-updates --configFileName .ncurc.major.mjs",
    "update-minor": "npm-check-updates --configFileName .ncurc.minor.mjs",
    "update-patch": "npm-check-updates --configFileName .ncurc.patch.mjs",
    "verify": "node scripts/verify.mjs",
    "watch:storybook": "pnpm --filter @gemeente-tilburg/design-tokens run build && pnpm --filter @gemeente-tilburg/components-react run build && pnpm --filter @gemeente-tilburg/web-components-stencil run build:stencil && pnpm --filter @gemeente-tilburg/web-components-react run build && pnpm --filter @gemeente-tilburg/storybook run storybook",
    "watch:storybook-angular": "pnpm --filter @gemeente-tilburg/design-tokens run build && pnpm --filter @gemeente-tilburg/components-angular run build:components && pnpm --filter @gemeente-tilburg/storybook-angular run storybook",
    "watch:style-dictionary": "pnpm --filter @gemeente-tilburg/design-tokens run watch:style-dictionary",
    "where": "node scripts/where.mjs"
  }
}
